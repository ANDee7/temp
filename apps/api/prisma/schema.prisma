generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceCategory {
  hair
  nails
  brows
  massage
  spa
  other
}

enum BookingStatus {
  created
  confirmed
  cancelled
  completed
  no_show
}

model Business {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  city        String
  timezone    String
  phone       String
  description String?
  services    Service[]
  staff       Staff[]
  bookings    Booking[]
}

model Service {
  id          String          @id @default(uuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  category    ServiceCategory
  durationMin Int
  price       Decimal
  currency    String          @default("RUB")
  isActive    Boolean         @default(true)
  bookings    Booking[]
  staffLinks  StaffService[]
}

model Staff {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName   String
  role       String
  services   StaffService[]
  bookings   Booking[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Client {
  id       String    @id @default(uuid())
  fullName String
  phone    String    @unique
  email    String?
  bookings Booking[]
}

model Booking {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staffId    String
  staff      Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  startAt    DateTime
  endAt      DateTime
  status     BookingStatus @default(created)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([businessId, startAt])
  @@index([staffId, startAt])
}
